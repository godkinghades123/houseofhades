{
  "version": "1.3.0",
  "updated": "2026-09-18",
  "description": "PP cheap capability index. Route first; load only matched tools.",
  "split_rule": {
    "github": "execution",
    "notion": "memory",
    "linear": "optional_project_mgmt",
    "automations": "reminders_schedule",
    "calendar": "time",
    "gmail": "comms",
    "drive": "files",
    "voice": "audio",
    "engine": "tastytrade_read_only"
  },
  "tools": {
    "github": {
      "display": "GitHub",
      "status": "connected",
      "keywords": [
        "github", "repo", "repository", "houseofhades", "commit", "push",
        "branch", "issue", "issues", "pull request", "pr", "label", "template",
        "code", "file in repo", "docs/", "yaml", "clone", "execution board"
      ],
      "capabilities": [
        "repo.read", "repo.modify", "issue.create", "issue.update",
        "issue.close", "label.manage", "project.board"
      ],
      "default_lane": "execution"
    },
    "notion": {
      "display": "Notion",
      "status": "connected",
      "keywords": [
        "notion", "continuity", "signal log", "treasury", "headquarters",
        "hq", "vault", "watchlist", "database", "data source", "data_source",
        "memory", "scroll library", "content calendar", "roadmap", "academy",
        "pp system", "underworld", "agent registry", "colony", "needs the duke",
        "needs human", "handoff", "thanatos", "persephone"
      ],
      "capabilities": [
        "knowledge.retrieve", "knowledge.write", "db.query", "db.update",
        "page.create", "page.update", "data_source.query", "data_source.update",
        "agent.registry", "colony.status"
      ],
      "default_lane": "memory",
      "note": "MCP v2.0.0: use data_source_* tools. Agent Registry data_source_id=017022ce-01c4-426a-a013-cd62407da630. See docs/NOTION_MCP_V2.md."
    },
    "engine": {
      "display": "Engine (Tastytrade)",
      "status": "connected_read_only",
      "owner_agent": "Thanatos Veyr",
      "realm": "Tartarus",
      "keywords": [
        "engine", "tastytrade", "tasty", "net liq", "net-liq", "net liquidating",
        "balance snapshot", "balance-snapshots", "account balances",
        "options buying power", "derivative buying power", "engine net liq",
        "phase 1 balances"
      ],
      "capabilities": [
        "engine.get_balances",
        "engine.get_balance_snapshots"
      ],
      "default_lane": "engine",
      "gates": [
        "Phase 1 defined-risk only",
        "No order submission",
        "No auto-trade",
        "Account lock via /customers/me/accounts + optional TASTYTRADE_ACCOUNT_NUMBER"
      ],
      "impl": "tools/engine/client.py",
      "note": "Read-only. Live path also feeds Ops Map Sync → synced_meta.json. Owner: Thanatos Veyr (tool-router)."
    },
    "linear": {
      "display": "Linear",
      "status": "connected_optional",
      "keywords": [
        "linear", "sprint", "cycle", "linear issue", "linear project"
      ],
      "capabilities": ["task.manage", "project.track"],
      "default_lane": "execution",
      "note": "HADES primary execution is GitHub Issues + Projects, not Linear."
    },
    "automations": {
      "display": "Automations",
      "status": "connected",
      "keywords": [
        "reminder", "remind me", "schedule", "every two days", "cron",
        "automation", "recurring"
      ],
      "capabilities": ["reminder.create", "schedule.prompt"],
      "default_lane": "ops"
    },
    "calendar": {
      "display": "Google Calendar",
      "status": "connected",
      "keywords": ["calendar", "meeting", "event", "appointment"],
      "capabilities": ["time.read", "time.write"],
      "default_lane": "ops"
    },
    "gmail": {
      "display": "Gmail",
      "status": "connected",
      "keywords": ["email", "gmail", "inbox", "send mail"],
      "capabilities": ["comms.read", "comms.send"],
      "default_lane": "ops"
    },
    "drive": {
      "display": "Google Drive",
      "status": "connected",
      "keywords": ["drive", "google doc", "spreadsheet file", "upload file"],
      "capabilities": ["files.read", "files.write"],
      "default_lane": "ops"
    },
    "voice": {
      "display": "Voice",
      "status": "connected",
      "keywords": ["voice", "speak", "tts", "audio narrate"],
      "capabilities": ["audio.speak"],
      "default_lane": "content"
    },
    "todoist": {
      "display": "Todoist",
      "status": "not_connected",
      "keywords": ["todoist", "todo list app"],
      "capabilities": ["task.manage"],
      "default_lane": "ops",
      "note": "Not connected. Prefer GitHub Issues or Notion Tasks Tracker."
    },
    "web": {
      "display": "Web / Market data",
      "status": "built_in",
      "keywords": [
        "market today", "price", "news", "search web", "how is the market",
        "nfp", "cpi", "fomc", "stock news"
      ],
      "capabilities": ["market.brief", "web.search"],
      "default_lane": "research"
    }
  },
  "capabilities": {
    "repo.modify": { "tool": "github", "examples": ["commit", "push files", "update README"] },
    "repo.read": { "tool": "github", "examples": ["read file from repo", "list issues"] },
    "issue.create": { "tool": "github", "examples": ["open github issue", "seed issues"] },
    "issue.update": { "tool": "github", "examples": ["close issue", "mark done on github"] },
    "knowledge.retrieve": { "tool": "notion", "examples": ["what does continuity say", "fetch signal log"] },
    "knowledge.write": { "tool": "notion", "examples": ["log to continuity", "update treasury", "add signal"] },
    "db.query": { "tool": "notion", "mcp_tool": "query-data-source", "examples": ["search notion database", "query data source"] },
    "db.update": { "tool": "notion", "mcp_tool": "update-a-data-source", "examples": ["update signal log row", "update data source"] },
    "data_source.query": { "tool": "notion", "mcp_tool": "query-data-source", "examples": ["query data source"] },
    "data_source.update": { "tool": "notion", "mcp_tool": "update-a-data-source", "examples": ["update data source properties"] },
    "agent.registry": {
      "tool": "notion",
      "mcp_tool": "query-data-source",
      "data_source_id": "017022ce-01c4-426a-a013-cd62407da630",
      "examples": ["who needs the Duke", "agent status", "colony status", "Needs Human agents", "open handoffs"]
    },
    "colony.status": {
      "tool": "notion",
      "mcp_tool": "query-data-source",
      "data_source_id": "017022ce-01c4-426a-a013-cd62407da630",
      "examples": ["colony status", "underworld residents"]
    },
    "engine.get_balances": {
      "tool": "engine",
      "impl": "tools/engine/client.py::get_balances / fetch_engine_snapshot",
      "owner_agent": "Thanatos Veyr",
      "examples": ["engine net liq", "tastytrade balances", "current options buying power"]
    },
    "engine.get_balance_snapshots": {
      "tool": "engine",
      "impl": "tools/engine/client.py::get_balance_snapshots",
      "owner_agent": "Thanatos Veyr",
      "examples": ["EOD balance snapshots", "engine history", "net liq last week"]
    },
    "task.manage": { "tool": "github", "fallback": ["notion", "linear"], "examples": ["todo", "task"] },
    "reminder.create": { "tool": "automations", "examples": ["remind me in 2 weeks"] },
    "market.brief": { "tool": "web", "also": ["notion"], "examples": ["how is the market today"] },
    "comms.read": { "tool": "gmail" },
    "time.read": { "tool": "calendar" },
    "files.read": { "tool": "drive" },
    "audio.speak": { "tool": "voice" }
  }
}
