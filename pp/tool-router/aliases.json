{
  "exact_phrases": {
    "how is the market today": { "tools": ["web", "notion"], "order": ["notion", "web"], "capability": "market.brief" },
    "how's the market": { "tools": ["web", "notion"], "order": ["notion", "web"], "capability": "market.brief" },
    "market update": { "tools": ["web", "notion"], "order": ["notion", "web"], "capability": "market.brief" },
    "search my notion": { "tools": ["notion"], "capability": "knowledge.retrieve" },
    "update signal log": { "tools": ["notion"], "capability": "knowledge.write" },
    "log to continuity": { "tools": ["notion"], "capability": "knowledge.write" },
    "close the issue": { "tools": ["github"], "capability": "issue.update" },
    "create a github issue": { "tools": ["github"], "capability": "issue.create" },
    "push to the repo": { "tools": ["github"], "capability": "repo.modify" },
    "commit this": { "tools": ["github"], "capability": "repo.modify" },
    "house of hades repo": { "tools": ["github"], "capability": "repo.modify" },
    "who needs the duke": { "tools": ["notion"], "capability": "agent.registry" },
    "who needs the Duke": { "tools": ["notion"], "capability": "agent.registry" },
    "agent status": { "tools": ["notion"], "capability": "agent.registry" },
    "colony status": { "tools": ["notion"], "capability": "colony.status" },
    "needs human agents": { "tools": ["notion"], "capability": "agent.registry" },
    "Needs Human agents": { "tools": ["notion"], "capability": "agent.registry" },
    "open handoffs": { "tools": ["notion"], "capability": "agent.registry" },
    "agent registry": { "tools": ["notion"], "capability": "agent.registry" },
    "Agent Registry": { "tools": ["notion"], "capability": "agent.registry" },
    "engine net liq": { "tools": ["engine"], "capability": "engine.get_balances" },
    "tastytrade balances": { "tools": ["engine"], "capability": "engine.get_balances" },
    "engine balances": { "tools": ["engine"], "capability": "engine.get_balances" },
    "balance snapshots": { "tools": ["engine"], "capability": "engine.get_balance_snapshots" },
    "engine snapshots": { "tools": ["engine"], "capability": "engine.get_balance_snapshots" }
  },
  "hard_rules": [
    {
      "id": "PP-ROUTE-001",
      "if_contains_any": ["commit", "push", "repository", "repo file", "issue template", "github issue"],
      "unless_contains": ["notion issue url only"],
      "force_tool": "github",
      "reason": "Repository / execution mutations always GitHub"
    },
    {
      "id": "PP-ROUTE-002",
      "if_contains_any": ["continuity", "signal log", "treasury", "headquarters", "scroll library", "content calendar"],
      "force_tool": "notion",
      "reason": "Memory and OS pages always Notion"
    },
    {
      "id": "PP-ROUTE-003",
      "if_contains_any": ["github and notion", "issue and signal log", "link issue to notion"],
      "force_tools": ["github", "notion"],
      "order": ["github", "notion"],
      "reason": "Cross-system: execute first, then memory link"
    },
    {
      "id": "PP-ROUTE-004",
      "if_contains_any": ["remind me", "set a reminder", "every two days"],
      "force_tool": "automations",
      "reason": "Reminders → Automations, not Todoist"
    },
    {
      "id": "PP-ROUTE-005",
      "if_contains_any": [
        "who needs the duke", "needs human", "agent status", "colony status",
        "open handoff", "agent registry", "underworld residents"
      ],
      "force_tool": "notion",
      "capability": "agent.registry",
      "reason": "Colony / Agent Registry always Notion data source"
    },
    {
      "id": "PP-ROUTE-006",
      "if_contains_any": [
        "engine net liq", "tastytrade balance", "engine balances",
        "balance snapshot", "options buying power", "net liquidating"
      ],
      "force_tool": "engine",
      "capability": "engine.get_balances",
      "reason": "Live Engine balances/snapshots → tools/engine (Thanatos / Tartarus). Read-only."
    }
  ]
}
