# Buffer Social Media Channel IDs
# Used for publishing HADES content cadence across social platforms
# Keep actual values in local .env (never commit)

# Instagram channel ID
BUFFER_CHANNEL_INSTAGRAM=

# X (formerly Twitter) channel ID
BUFFER_CHANNEL_X=

# TikTok channel ID
BUFFER_CHANNEL_TIKTOK=

# Optional: Buffer API token for publishing verification
BUFFER_API_TOKEN=

# Optional: Content staging environment
BUFFER_ENVIRONMENT=staging
